# ==========================================
# Configurações do Banco de Dados (PostgreSQL)
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gestao_salas
POSTGRES_USER=gestao_salas
POSTGRES_PASSWORD=changeme_local_only
DATABASE_URL=postgresql://gestao_salas:changeme_local_only@localhost:5432/gestao_salas

# ==========================================
# Autenticação e Segurança (FastAPI)
# ==========================================
SECRET_KEY=super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==========================================
# Integração ClickUp (Automação SDD)
# ==========================================
# Obtenha em: ClickUp Settings -> Apps -> API Token (formato pk_...)
CLICKUP_API_KEY=pk_your_clickup_api_key_here

# ID da Lista onde as tarefas do SIGAAS serão criadas (encontrado na URL da lista no ClickUp)
CLICKUP_LIST_ID=your_clickup_list_id_here

# (Opcional) ID do Espaço ou Workspace
CLICKUP_WORKSPACE_ID=
CLICKUP_SPACE_ID=
